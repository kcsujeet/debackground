---
import BeforeAfterSlider from "../components/BeforeAfterSlider";
import Header from "../components/Header";
import Footer from "../components/Footer";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="PureBG - Professional AI-Powered Background Removal">
	<main class="relative bg-background text-foreground">
		<Header />
		
		<!-- Hero Section -->
		<section class="relative pt-48 pb-24 px-6 overflow-hidden">
			<!-- Background Glow -->
			<div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[600px] bg-linear-to-b from-primary/10 to-transparent blur-3xl -z-10 opacity-50"></div>

			<div class="max-w-[1400px] mx-auto">
				<div class="max-w-4xl mx-auto text-center space-y-8">
					<div class="inline-flex items-center gap-2 px-3 py-1.5 bg-card rounded-full border border-border text-xs text-muted-foreground font-medium animate-in fade-in slide-in-from-top-4 duration-700">
						<div class="w-1.5 h-1.5 bg-primary rounded-full animate-pulse"></div>
						AI-Powered & 100% Private
					</div>

					<h1 class="text-6xl md:text-8xl font-semibold tracking-tight leading-[1.05] animate-in fade-in slide-in-from-bottom-4 duration-1000">
						Professional <br />
						<span class="text-gradient">background removal</span>
					</h1>

					<p class="text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed animate-in fade-in slide-in-from-bottom-8 duration-1000 delay-200">
						Get studio-quality results in seconds. Powered by state-of-the-art AI, 
						running entirely in your browser. No accounts, no fees, no tracking.
					</p>

					<div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4 animate-in fade-in slide-in-from-bottom-12 duration-1000 delay-300">
						<a 
							href="/remove" 
							class="group px-8 py-4 bg-primary text-primary-foreground rounded-2xl font-bold text-base hover:bg-primary/90 transition-all flex items-center gap-3 shadow-xl shadow-primary/10"
						>
							Remove background
							<svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
							</svg>
						</a>
						<a 
							href="#features" 
							class="px-8 py-4 bg-card hover:bg-muted text-foreground rounded-2xl font-semibold text-base transition-all border border-border"
						>
							See how it works
						</a>
					</div>
				</div>

				<!-- Hero Visual -->
				<div class="mt-24 max-w-5xl mx-auto relative group animate-in zoom-in-95 fade-in duration-1000 delay-500">
					<div class="absolute -inset-4 bg-linear-to-r from-primary/10 to-primary/5 blur-2xl opacity-20 group-hover:opacity-30 transition-opacity"></div>
					<div class="relative bg-card p-2 rounded-3xl border border-border shadow-2xl overflow-hidden">
						<BeforeAfterSlider 
							client:load
							showCheckered={false}
							beforeImage="/images/demo-before.png"
							afterImage="/images/demo-after.png"
						/>
					</div>
				</div>
			</div>
		</section>

		<!-- Features & Values -->
		<section id="features" class="relative py-32 px-6 border-t border-border">
			<div class="max-w-[1400px] mx-auto">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="p-10 rounded-2xl bg-card border border-border hover:border-primary/50 transition-all">
						<div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-8 border border-primary/20">
							<svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
							</svg>
						</div>
						<h3 class="text-xl font-bold text-foreground mb-4 text-balance leading-tight">Private by Design</h3>
						<p class="text-muted-foreground leading-relaxed">Your images never leave your computer. All AI processing happens purely on your device.</p>
					</div>

					<div class="p-10 rounded-2xl bg-card border border-border hover:border-primary/50 transition-all">
						<div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-8 border border-primary/20">
							<svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
							</svg>
						</div>
						<h3 class="text-xl font-bold text-foreground mb-4 text-balance leading-tight">Instant Export</h3>
						<p class="text-muted-foreground leading-relaxed">Full-resolution downloads without hidden costs or account requirements.</p>
					</div>

					<div class="p-10 rounded-2xl bg-card border border-border hover:border-primary/50 transition-all">
						<div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-8 border border-primary/20">
							<svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
							</svg>
						</div>
						<h3 class="text-xl font-bold text-foreground mb-4 text-balance leading-tight">Studio Quality</h3>
						<p class="text-muted-foreground leading-relaxed">State-of-the-art AI models handle hair, complex edges, and fine details with ease.</p>
					</div>
				</div>
			</div>
		</section>

		<Footer />
	</main>
</Layout>
