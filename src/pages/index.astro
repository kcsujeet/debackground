---
import BackgroundRemover from "../components/BackgroundRemover";
import BeforeAfterSlider from "../components/BeforeAfterSlider";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="Background Remover - Professional AI-Powered Background Removal">
	<main class="relative bg-background text-text-primary">
		<!-- Subtle gradient background -->
		<div class="fixed inset-0 bg-linear-to-br from-background via-background to-surface pointer-events-none"></div>
		
		<!-- Grid pattern overlay -->
		<div class="fixed inset-0 opacity-[0.015]" style="background-image: linear-gradient(currentColor 1px, transparent 1px), linear-gradient(90deg, currentColor 1px, transparent 1px); background-size: 64px 64px; color: var(--color-text-primary);"></div>

		<!-- Navigation -->
		<nav class="relative z-50 border-b border-border/50">
			<div class="max-w-[1400px] mx-auto px-6 lg:px-8">
				<div class="flex items-center justify-between h-16">
					<div class="flex items-center gap-2 text-sm font-medium">
						<div class="w-6 h-6 bg-linear-to-br from-primary to-accent-purple rounded-md"></div>
						<span class="text-text-primary/90">Background Remover</span>
					</div>
					
					<div class="hidden md:flex items-center gap-8 text-sm">
						<a href="#features" class="text-text-secondary hover:text-text-primary transition-colors">Features</a>
						<a href="#app" class="text-text-secondary hover:text-text-primary transition-colors">Try it</a>
						<div class="flex items-center gap-2 px-3 py-1.5 bg-surface hover:bg-border/30 rounded-md transition-colors border border-border/50">
							<div class="w-1.5 h-1.5 bg-success rounded-full"></div>
							<span class="text-xs text-text-primary/80">100% Local</span>
						</div>
					</div>
				</div>
			</div>
		</nav>

		<!-- Hero Section -->
		<section class="relative pt-32 pb-20 px-6">
			<div class="max-w-[1400px] mx-auto">
				<div class="max-w-4xl mx-auto text-center space-y-8">
					<!-- Badge -->
					<div class="inline-flex items-center gap-2 px-3 py-1.5 bg-surface rounded-full border border-border/50 text-xs text-text-secondary">
						<div class="w-1 h-1 bg-primary rounded-full animate-pulse"></div>
						Powered by BiRefNet & ModNet AI
					</div>

					<!-- Headline -->
					<h1 class="text-5xl md:text-7xl lg:text-8xl font-semibold tracking-tight leading-[1.1]">
						<span class="text-text-primary/90">Remove backgrounds</span>
						<br />
						<span class="text-gradient">in seconds</span>
					</h1>

					<!-- Subheadline -->
					<p class="text-lg md:text-xl text-text-secondary max-w-2xl mx-auto leading-relaxed">
						Professional-grade background removal powered by AI. 
						Everything runs locally in your browser—no uploads, no accounts, no tracking.
					</p>

					<!-- CTA -->
					<div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
						<a 
							href="#app" 
							class="group px-6 py-3 bg-white text-background rounded-lg font-medium text-sm hover:bg-white/90 transition-all flex items-center gap-2"
						>
							Get started
							<svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
							</svg>
						</a>
						<a 
							href="#features" 
							class="px-6 py-3 bg-surface hover:bg-border/30 text-text-primary/90 rounded-lg font-medium text-sm transition-all border border-border/50"
						>
							Learn more
						</a>
					</div>
				</div>

				<!-- Hero Visual -->
				<div class="mt-20 max-w-5xl mx-auto">
					<BeforeAfterSlider 
						client:load
						beforeImage="/images/demo-before.png"
						afterImage="/images/demo-after.png"
					/>
					
					<!-- Stats overlay -->
					<div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
						<div class="px-4 py-2.5 bg-surface/90 backdrop-blur-md rounded-lg border border-border text-xs font-medium text-text-primary">
							<span class="text-white font-semibold">AI-Powered</span> • Instant Results
						</div>
						<div class="px-4 py-2.5 bg-success/20 backdrop-blur-md rounded-lg border border-success/30 text-xs text-success font-semibold">
							✓ 100% Local Processing
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Features -->
		<section id="features" class="relative py-32 px-6 border-t border-border/50">
			<div class="max-w-[1400px] mx-auto">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="p-8 rounded-xl bg-surface border border-border/50 hover:bg-border/20 transition-all group">
						<div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-6 border border-primary/20">
							<svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
							</svg>
						</div>
						<h3 class="text-lg font-semibold text-text-primary/90 mb-3">Private by design</h3>
						<p class="text-sm text-text-secondary leading-relaxed">Your images never leave your device. All processing happens locally using WebAssembly.</p>
					</div>

					<div class="p-8 rounded-xl bg-surface border border-border/50 hover:bg-border/20 transition-all group">
						<div class="w-10 h-10 rounded-lg bg-success/10 flex items-center justify-center mb-6 border border-success/20">
							<svg class="w-5 h-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
							</svg>
						</div>
						<h3 class="text-lg font-semibold text-text-primary/90 mb-3">Lightning fast</h3>
						<p class="text-sm text-text-secondary leading-relaxed">No server queues or upload times. Instant results powered by your GPU.</p>
					</div>

					<div class="p-8 rounded-xl bg-surface border border-border/50 hover:bg-border/20 transition-all group">
						<div class="w-10 h-10 rounded-lg bg-warning/10 flex items-center justify-center mb-6 border border-warning/20">
							<svg class="w-5 h-5 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
							</svg>
						</div>
						<h3 class="text-lg font-semibold text-text-primary/90 mb-3">Professional quality</h3>
						<p class="text-sm text-text-secondary leading-relaxed">State-of-the-art AI models deliver crisp edges and accurate segmentation.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- App Section -->
		<section id="app" class="relative py-32 px-6 border-t border-border/50">
			<div class="max-w-6xl mx-auto">
				<div class="text-center space-y-4 mb-16">
					<h2 class="text-4xl md:text-5xl font-semibold text-text-primary/90 tracking-tight">Try it now</h2>
					<p class="text-text-secondary">Upload an image to see the magic happen</p>
				</div>
				
				<BackgroundRemover client:load />
			</div>
		</section>

		<!-- Footer -->
		<footer class="relative py-16 px-6 border-t border-border/50">
			<div class="max-w-[1400px] mx-auto">
				<div class="flex flex-col md:flex-row items-center justify-between gap-6">
					<div class="flex items-center gap-2 text-sm text-text-tertiary">
						<div class="w-5 h-5 bg-linear-to-br from-primary to-accent-purple rounded"></div>
						<span>© 2025 Background Remover</span>
					</div>
					<div class="flex items-center gap-8 text-sm text-text-tertiary">
						<a href="#" class="hover:text-text-secondary transition-colors">GitHub</a>
						<a href="#" class="hover:text-text-secondary transition-colors">Privacy</a>
						<a href="#" class="hover:text-text-secondary transition-colors">Terms</a>
					</div>
				</div>
			</div>
		</footer>
	</main>
</Layout>
