---
import BeforeAfterSlider from "../components/BeforeAfterSlider";
import Header from "../components/Header";
import Footer from "../components/Footer";
import Layout from "../layouts/Layout.astro";
---

<Layout 
	title="Unbgly - Free Unlimited AI Background Remover | HD Quality"
	description="Unbgly is a professional, free, and private AI background remover that runs entirely in your browser. Get HD quality results instantly with no signups or fees."
>
	<main class="relative bg-background text-foreground">
		<Header />
		
		<!-- Hero Section -->
		<section class="relative pt-32 md:pt-48 pb-24 overflow-hidden">
			<!-- Background Glow -->
			<div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[600px] bg-linear-to-b from-primary/10 to-transparent blur-3xl -z-10 opacity-50"></div>

			<div class="max-w-[1400px] mx-auto px-6 md:px-8">
				<div class="max-w-4xl mx-auto text-center space-y-8">
					<div class="inline-flex items-center gap-2 px-3 py-1.5 bg-card rounded-full border border-border text-xs text-muted-foreground font-medium animate-in fade-in slide-in-from-top-4 duration-500">
						<div class="w-1.5 h-1.5 bg-primary rounded-full animate-pulse"></div>
						AI-Powered & 100% Private
					</div>

					<h1 class="text-4xl md:text-6xl lg:text-8xl font-semibold tracking-tight leading-[1.05] animate-in fade-in slide-in-from-bottom-4 duration-700">
						Professional <br />
						<span class="text-primary font-heading">background removal</span>
					</h1>

					<p class="text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed animate-in fade-in slide-in-from-bottom-8 duration-700 delay-100">
						Get studio-quality results in seconds. Powerful AI-based <strong>background remover</strong> 
						running entirely in your browser. Unlimited use, no accounts, and 100% free.
					</p>

					<div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4 animate-in fade-in slide-in-from-bottom-12 duration-700 delay-200">
						<a 
							href="/remove" 
							class="group px-8 py-4 bg-primary text-primary-foreground rounded-2xl font-bold text-base hover:bg-primary/90 transition-all flex items-center gap-3 shadow-xl shadow-primary/10"
						>
							Remove background
							<svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
							</svg>
						</a>
						<a 
							href="#features" 
							class="px-8 py-4 bg-card hover:bg-muted text-foreground rounded-2xl font-semibold text-base transition-all border border-border"
						>
							See how it works
						</a>
					</div>
				</div>

				<!-- Hero Visual -->
				<div class="mt-24 max-w-5xl mx-auto relative group animate-in zoom-in-95 fade-in duration-700 delay-300">
					<div class="absolute -inset-4 bg-linear-to-r from-primary/10 to-primary/5 blur-2xl opacity-20 group-hover:opacity-30 transition-opacity"></div>
					<div class="relative bg-card p-2 rounded-3xl border border-border shadow-2xl overflow-hidden">
						<BeforeAfterSlider 
							client:load
							showCheckered={false}
							beforeImage="/images/demo-before.png"
							afterImage="/images/demo-after.png"
						/>
					</div>
				</div>
			</div>
		</section>

		<!-- Features & Values -->
		<section id="features" class="relative py-24 md:py-32 overflow-hidden">
			<!-- Subtle Background Blobs for the section -->
			<div class="absolute top-1/2 left-0 -translate-y-1/2 w-[500px] h-[500px] bg-primary/5 blur-[120px] -z-10 rounded-full"></div>
			<div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-indigo-500/5 blur-[100px] -z-10 rounded-full"></div>

			<div class="max-w-[1400px] mx-auto px-6 md:px-8">
				<div class="flex flex-col md:flex-row items-end justify-between mb-16 gap-8">
					<div class="max-w-2xl space-y-4">
						<h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight text-foreground">
							Engineered for <span class="text-primary">precision</span>.
						</h2>
						<p class="text-lg text-muted-foreground leading-relaxed">
							Unbgly combines edge-cutting AI with browser-native performance to give you a tool that's as fast as it is private.
						</p>
					</div>
					<div class="hidden md:block h-px bg-border grow mx-12 mb-4 opacity-50"></div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8">
					<!-- Feature 1: Privacy (Large Card) -->
					<div class="md:col-span-7 group relative p-10 rounded-3xl bg-card/40 backdrop-blur-xl border border-border/50 hover:border-primary/40 hover:-translate-y-1 hover:shadow-2xl hover:shadow-primary/5 transition-all duration-500">
						<div class="absolute inset-0 bg-linear-to-br from-primary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity rounded-3xl"></div>
						
						<div class="relative z-10">
							<div class="w-14 h-14 rounded-2xl bg-indigo-500/10 flex items-center justify-center mb-8 border border-indigo-500/20 group-hover:scale-110 transition-transform duration-500">
								<svg class="w-7 h-7 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
								</svg>
							</div>
							<h3 class="text-2xl font-bold text-foreground mb-4">100% On-Device Privacy</h3>
							<p class="text-muted-foreground text-lg leading-relaxed max-w-md">
								Unlike other tools, Unbgly never uploads your photos to a server. 
								The AI models run directly in your browser, keeping your data completely offline and secure.
							</p>
						</div>
						
						<!-- Decorative element -->
						<div class="absolute bottom-6 right-8 text-primary/5 select-none pointer-events-none transition-transform duration-700 group-hover:translate-x-2">
							<svg width="120" height="120" viewBox="0 0 24 24" fill="currentColor">
								<path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" />
							</svg>
						</div>
					</div>

					<!-- Feature 2: Speed (Small Card) -->
					<div class="md:col-span-5 group relative p-10 rounded-3xl bg-card/40 backdrop-blur-xl border border-border/50 hover:border-amber-500/40 hover:-translate-y-1 transition-all duration-500">
						<div class="w-14 h-14 rounded-2xl bg-amber-500/10 flex items-center justify-center mb-8 border border-amber-500/20 group-hover:scale-110 transition-transform duration-500">
							<svg class="w-7 h-7 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
							</svg>
						</div>
						<h3 class="text-2xl font-bold text-foreground mb-4">Instant Processing</h3>
						<p class="text-muted-foreground leading-relaxed">
							No waiting in queues or processing delays. Get your isolated subjects in milliseconds with high-performance WASM inference.
						</p>
					</div>

					<!-- Feature 3: Quality (Small Card) -->
					<div class="md:col-span-5 group relative p-10 rounded-3xl bg-card/40 backdrop-blur-xl border border-border/50 hover:border-violet-500/40 hover:-translate-y-1 transition-all duration-500">
						<div class="w-14 h-14 rounded-2xl bg-violet-500/10 flex items-center justify-center mb-8 border border-violet-500/20 group-hover:scale-110 transition-transform duration-500">
							<svg class="w-7 h-7 text-violet-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
							</svg>
						</div>
						<h3 class="text-2xl font-bold text-foreground mb-4">Studio-Grade Extraction</h3>
						<p class="text-muted-foreground leading-relaxed">
							Handles fine details like hair and transparent objects with precision. Pro-level results without the pro price tag.
						</p>
					</div>

					<!-- Feature 4: Unlimited (Large Card) -->
					<div class="md:col-span-7 group relative p-10 rounded-3xl bg-card/40 backdrop-blur-xl border border-border/50 hover:border-emerald-500/40 hover:-translate-y-1 hover:shadow-2xl hover:shadow-emerald-500/5 transition-all duration-500">
						<div class="absolute inset-0 bg-linear-to-br from-emerald-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity rounded-3xl"></div>
						
						<div class="relative z-10 flex flex-col h-full">
							<div class="w-14 h-14 rounded-2xl bg-emerald-500/10 flex items-center justify-center mb-8 border border-emerald-500/20 group-hover:scale-110 transition-transform duration-500">
								<svg class="w-7 h-7 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
								</svg>
							</div>
							<div class="mt-auto">
								<h3 class="text-2xl font-bold text-foreground mb-4">Unlimited High-Res Exports</h3>
								<p class="text-muted-foreground text-lg leading-relaxed max-w-lg">
									We don't limit your resolution or daily usage. Process as many images as you need, 
									at full resolution, for absolutely zero cost. It's the ultimate utility for creators.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<Footer />
	</main>
</Layout>
