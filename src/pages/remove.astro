---
import BackgroundRemover from "../components/BackgroundRemover";
import Header from "../components/Header";
import Footer from "../components/Footer";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="PureBG - Remove Backgrounds Locally">
	<main class="relative min-h-screen bg-background text-foreground flex flex-col">
		<Header />
		
		<!-- Tool Section -->
		<section class="grow pt-32 pb-20 px-6">
			<div class="max-w-6xl mx-auto">
				<div class="text-center space-y-4 mb-12">
					<h1 class="text-4xl md:text-5xl font-semibold text-foreground tracking-tight">Remove Background</h1>
					<p class="text-muted-foreground max-w-xl mx-auto text-balance">
						Upload your image to remove the background instantly. 
						Processing is 100% private and happens entirely in your browser.
					</p>
				</div>
				
				<BackgroundRemover client:load />
			</div>
		</section>

		<Footer />
	</main>
</Layout>
